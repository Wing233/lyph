{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lyph 采集台",
  "version": "0.1.0",
  "identifier": "com.lyph.collector",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "lyph · 采集台", "width": 840, "height": 700, "minWidth": 420, "minHeight": 540 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
