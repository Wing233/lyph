# Copy to .env and replace every CHANGE_ME value.
# Better: run `uv run --project api lyph init-config --output .env ...`
# The generator creates random secrets and an Argon2id owner password hash.
# Never commit .env.

# --- required ---
LYPH_SECRET_KEY=CHANGE_ME_48_RANDOM_CHARS
LYPH_OWNER_PASSWORD_HASH=CHANGE_ME_ARGON2ID_HASH
LYPH_FRONTEND_ORIGIN=http://127.0.0.1:8080
LYPH_SECURE_COOKIES=false

LYPH_MINIO_ENDPOINT=minio:9000
LYPH_MINIO_REGION=
LYPH_MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
LYPH_MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
LYPH_MINIO_BUCKET=lyph-private
LYPH_MINIO_SECURE=false
# Backblaze B2 example:
# LYPH_MINIO_ENDPOINT=s3.us-west-004.backblazeb2.com
# LYPH_MINIO_REGION=us-west-004
# LYPH_MINIO_SECURE=true

# --- compose ---
LYPH_BIND_ADDRESS=127.0.0.1
LYPH_HTTP_PORT=8080
LYPH_PROXY_IP=172.30.91.254
LYPH_PRIVATE_SUBNET=172.30.91.0/24
FORWARDED_ALLOW_IPS=172.30.91.254

# --- optional ---
LYPH_DATA_DIR=./data
LYPH_DATABASE_PATH=./data/lyph.sqlite3
LYPH_SOURCE_DIR=./web
LYPH_UI_DIR=./runtime/ui
LYPH_CHAT_FIRST_ENABLED=false
LYPH_PUBLIC_ORIGIN=http://127.0.0.1:8080
LYPH_CERT_NAME=your-domain.example

# Optional enterprise snapshot. Leave empty to disable those tools.
# LYPH_ENTERPRISE_DATABASE_PATH=./public-apps/companies/data/web.sqlite

# Optional Docker-backed UI preview. Requires the docker group id.
# LYPH_DOCKER_GID=1000
